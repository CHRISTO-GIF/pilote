    "segments": [
      {
        "src": "32778876",
        "start": 0.0,
        "dur": 7.5,
        "text": "Ils arrivent tôt."
      },
      {
        "src": "32778876",
        "start": 9.0,
        "dur": 7.5,
        "text": "Ils écoutent."
      },
      {
        "src": "29430344",
        "start": 0.5,
        "dur": 8.0,
        "text": "Ils rient aussi."
      },
      {
        "src": "32778875",
        "start": 0.5,
        "dur": 8.0,
        "text": "Ils réfléchissent."
      },
      {
        "src": "11025452",
        "start": 1.0,
        "dur": 8.0,
        "text": "Ils écrivent leur avenir."
      }
