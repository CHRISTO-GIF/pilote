  "chemin": {
    "title": "Le chemin",
    "segments": [
      {
        "src": "37471477",
        "start": 2.0,
        "dur": 12.0,
        "text": "Le chemin est long."
      },
      {
        "src": "30783914",
        "start": 0.0,
        "dur": 10.0,
        "text": "Mais chaque pas compte."
      },
      {
        "src": "37471477",
