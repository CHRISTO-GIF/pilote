  "main": {
    "title": "La main levée",
    "segments": [
      {
        "src": "5904549",
        "start": 0.5,
        "dur": 9.0,
        "text": "Le jour où un élève timide lève la main…"
      },
      {
        "src": "5897643",
        "start": 0.5,
        "dur": 9.0,
        "text": "…c'est qu'un enseignant lui a donné confiance."
      },
      {
        "src": "5897653",
        "start": 0.0,
        "dur": 9.0,
        "text": "Merci pour ces petits gestes qui changent tout."
      }
    ],
    "end": "Croire en eux. Toujours."
  },
  "aube": {
    "title": "Nouvelle page",
    "segments": [
      {
        "src": "36441545",
        "start": 2.0,
        "dur": 10.0,
        "text": "Hier est derrière nous."
      },
      {
        "src": "36441545",
        "start": 14.0,
        "dur": 10.0,
        "text": "Le soleil se lève encore."
      },
      {
        "src": "36441545",
        "start": 28.0,
        "dur": 10.0,
        "text": "Demain matin, une nouvelle page."
      }
    ],
    "end": "On recommence."
  },
  "ecrire": {
    "title": "Écrire, recommencer",
    "segments": [
      {
        "src": "11025452",
        "start": 0.5,
        "dur": 9.0,
        "text": "Écrire."
      },
      {
        "src": "8617390",
        "start": 0.0,
        "dur": 8.5,
        "text": "Se tromper. Effacer."
      },
      {
        "src": "8927661",
        "start": 2.0,
